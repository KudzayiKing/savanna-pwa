rules_version = '2';

// ---------------------------------------------------------------------------
// Savanna — Firestore security rules
//
// These rules ARE the authorisation layer. The browser talks to Firestore
// directly and the project's web config ships inside the bundle, so there is no
// server of ours in front of this data to catch a mistake. Anything not
// explicitly allowed below is denied.
//
// Pair this with App Check (see client/src/lib/firebase.ts). Rules decide what a
// signed-in user may read; App Check decides whether the caller is your app at
// all. Rules alone still hold, but without App Check anyone can lift the public
// config from the browser and script against your project on your bill.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validAdminRole(value) {
      return value in [
        'super_admin', 'support_admin', 'moderator', 'merchant_admin',
        'community_admin', 'analyst'
      ];
    }

    /**
     * The role carried in the Firebase custom claim.
     *
     * This is the authoritative role. Claims are minted by the Admin SDK on a
     * trusted machine and ride inside the ID token, so a user cannot influence
     * their own value — unlike a field in a document they can write to.
     *
     * The two legacy boolean/string markers are folded into `super_admin` so
     * that accounts provisioned before the role system existed keep working.
     * Returns null for everyone else.
     *
     * CRITICAL: `request.auth.token` is a *claims* object, not a permissive
     * Map. Reading a claim key that is absent THROWS ("Property X is undefined
     * on object") instead of returning null. Every claim access below must go
     * through `.get(key, null)`, which returns the default for absent keys
     * without throwing. A bare `request.auth.token.adminRole` works while the
     * claim is present but throws for ordinary users (who have no such claim),
     * which cascades into a deny on every rule that calls this function.
     */
    function adminClaimRole() {
      return signedIn() ? (
        validAdminRole(request.auth.token.get('adminRole', null))
          ? request.auth.token.get('adminRole', null)
          : (
            request.auth.token.get('admin', null) == true
            || request.auth.token.get('role', null) == 'admin'
          ) ? 'super_admin' : null
      ) : null;
    }

    function isAdmin() {
      return signedIn()
        && (
          adminClaimRole() != null
          || (
            // Read-only fallback. Roles used to live in the user document; this
            // keeps those accounts able to *see* the console after a claim has
            // been issued but before the cached ID token has refreshed. It is
            // deliberately NOT used for writes — see canPerform().
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && validAdminRole(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminRole)
          )
        );
    }

    /**
     * Server-side mirror of ADMIN_ROLE_PERMISSIONS in
     * client/src/lib/firebaseAdmin.ts.
     *
     * The client copy decides which buttons are enabled; this copy decides
     * whether the write actually lands. They must be kept in step — if a role
     * gains a permission here but not there, the button stays disabled; if it
     * gains one there but not here, the action fails with permission-denied.
     *
     * Only the claim is consulted. A role written into the user document is
     * not enough to act, because that field is reachable from code the user
     * controls.
     */
    function canPerform(permission) {
      return adminClaimRole() == 'super_admin'
        || (adminClaimRole() == 'support_admin' && permission in ['user.moderate', 'report.triage', 'content.remove'])
        || (adminClaimRole() == 'moderator' && permission in ['report.triage', 'community.review', 'content.remove'])
        || (adminClaimRole() == 'merchant_admin' && permission in ['shop.review'])
        || (adminClaimRole() == 'community_admin' && permission in ['community.review']);
    }

    /**
     * Whether this account can write at all — i.e. it holds a real claim and
     * that claim is not the read-only `analyst` role.
     *
     * This is only the coarse gate. Every write branch below additionally
     * calls canPerform() with the specific permission that action needs, so
     * passing this function is never on its own sufficient to change anything.
     */
    function canWriteAdmin() {
      return isAdmin() && adminClaimRole() != null && adminClaimRole() != 'analyst';
    }

    function validUsername(value) {
      return value == null || (value is string && value.matches('^[a-z0-9_]{3,24}$'));
    }

    // `resource` is null on create, so this helper is only valid for
    // read/update/delete. Create rules check `request.resource` instead.
    function isMember(conversation) {
      return signedIn()
        && conversation != null
        && conversation.data.memberIds is list
        && request.auth.uid in conversation.data.memberIds;
    }

    function conversationRef(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId));
    }

    function communityPath(communityId) {
      return /databases/$(database)/documents/communities/$(communityId);
    }

    function storefrontPath(storefrontId) {
      return /databases/$(database)/documents/storefronts/$(storefrontId);
    }

    function communityMemberPath(communityId, uid) {
      return /databases/$(database)/documents/communities/$(communityId)/members/$(uid);
    }

    function productPath(productId) {
      return /databases/$(database)/documents/products/$(productId);
    }

    function isCommunityMember(communityId) {
      return signedIn()
        && exists(communityMemberPath(communityId, request.auth.uid));
    }

    function validCommunityPostCommerce() {
      return request.resource.data.get('productId', null) == null
        || (
          request.resource.data.productId is string
          && exists(productPath(request.resource.data.productId))
          && get(productPath(request.resource.data.productId)).data.storefrontOwnerUserId == request.auth.uid
          && request.resource.data.storefrontId == get(productPath(request.resource.data.productId)).data.storefrontId
          && request.resource.data.storefrontSlug == get(productPath(request.resource.data.productId)).data.storefrontSlug
          && request.resource.data.storefrontName == get(productPath(request.resource.data.productId)).data.storefrontName
          && request.resource.data.productName == get(productPath(request.resource.data.productId)).data.title
          && request.resource.data.productDescription == get(productPath(request.resource.data.productId)).data.description
          && request.resource.data.productPriceMinor == get(productPath(request.resource.data.productId)).data.priceMinor
          && request.resource.data.productCurrencyCode == get(productPath(request.resource.data.productId)).data.currencyCode
          && request.resource.data.productPrimaryImageUrl == get(productPath(request.resource.data.productId)).data.primaryImageUrl
        );
    }

    function validStoryStorefrontTarget() {
      return request.resource.data.get('storefrontId', null) == null
        || (
          request.resource.data.storefrontId is string
          && exists(storefrontPath(request.resource.data.storefrontId))
          && get(storefrontPath(request.resource.data.storefrontId)).data.ownerUserId == request.auth.uid
          && request.resource.data.storefrontSlug == get(storefrontPath(request.resource.data.storefrontId)).data.slug
          && request.resource.data.storefrontName == get(storefrontPath(request.resource.data.storefrontId)).data.name
        );
    }

    function validStoryCommunityTarget() {
      return request.resource.data.get('communityId', null) == null
        || (
          request.resource.data.communityId is string
          && isCommunityMember(request.resource.data.communityId)
          && get(communityPath(request.resource.data.communityId)).data.visibility == 'public'
          && request.resource.data.communityName == get(communityPath(request.resource.data.communityId)).data.name
        );
    }

    function validConversationCreate() {
      return request.resource.data.keys().hasOnly([
          'kind', 'title', 'memberIds', 'directKey', 'inviteCode', 'storefrontId',
          'storefrontSlug', 'createdAt', 'updatedAt', 'lastMessageAt',
          'lastMessageId', 'lastMessageSenderId', 'lastMessagePreview',
          'lastMessageStatus', 'mutedUntil', 'unreadCount'
        ])
        && request.resource.data.kind in ['direct', 'group', 'merchant_support']
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() >= 2
        && request.auth.uid in request.resource.data.memberIds
        && (
          request.resource.data.kind != 'direct'
          || (
            request.resource.data.memberIds.size() == 2
            && request.resource.data.directKey is string
          )
        );
    }

    // --- Profiles ----------------------------------------------------------

    match /users/{uid} {
      // Private account profile. This may contain auth-derived contact details,
      // so only the owner can read it. Public lookup lives in publicProfiles.
      allow read: if isSelf(uid) || isAdmin();

      // The field whitelist matters. Without it a user could write any
      // attribute onto their own profile — including anything the app later
      // learns to trust, such as a role or a verification flag. Adding a field
      // to the app means adding it here.
      // `adminRole` and `accountStatus` are tolerated on create only because
      // ensureUserProfile() seeds them when an admin signs in for the first
      // time. Left unconstrained that would be a privilege escalation — anyone
      // could mint themselves an admin — so each is pinned: adminRole may only
      // be null or the role already present in the caller's own token claim,
      // and a new account always starts active. Neither field is writable via
      // update, so this is the one and only moment they can be set.
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(
               [
               'name', 'username', 'usernameLower', 'email', 'phoneNumber',
               'photoURL', 'bio', 'city', 'countryCode', 'profileVisibility',
               'phoneVisibility',
               'handleDiscoverability', 'storyAudienceDefault',
               'readReceiptsEnabled', 'lastSeenVisibility',
               'courseProgressOptIn', 'adminRole', 'accountStatus',
               'createdAt', 'updatedAt'
             ])
        && validUsername(request.resource.data.get('usernameLower', null))
        && (
          request.resource.data.get('adminRole', null) == null
          || request.resource.data.adminRole == adminClaimRole()
        )
        && request.resource.data.get('accountStatus', 'active') == 'active';

      allow update: if (
          isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               [
                 'name', 'username', 'usernameLower', 'email', 'phoneNumber',
                 'photoURL', 'bio', 'city', 'countryCode', 'profileVisibility',
                 'phoneVisibility',
                 'handleDiscoverability', 'storyAudienceDefault',
                 'readReceiptsEnabled', 'lastSeenVisibility',
                 'courseProgressOptIn', 'createdAt', 'updatedAt'
               ])
          && validUsername(request.resource.data.get('usernameLower', null))
        )
        || (
          canWriteAdmin()
          && canPerform('user.moderate')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'accountStatus', 'messagingRestricted', 'postingRestricted',
            'verified', 'moderationUpdatedAt', 'updatedAt',
            // Appeal handling. Recorded on the account itself rather than in a
            // separate collection so the decision sits next to the suspension
            // it belongs to, and so a moderator reviewing the account sees the
            // appeal without a second query.
            'banAppealStatus', 'banAppealNote', 'banAppealAt',
            'banAppealReviewedBy', 'banAppealReviewedAt'
          ])
          && request.resource.data.accountStatus in ['active', 'suspended', 'banned']
          && request.resource.data.get('messagingRestricted', false) is bool
          && request.resource.data.get('postingRestricted', false) is bool
          && request.resource.data.get('verified', false) is bool
          && request.resource.data.get('banAppealStatus', 'none') in ['none', 'pending', 'upheld', 'overturned']
          && (request.resource.data.get('banAppealNote', null) == null
              || (request.resource.data.banAppealNote is string
                  && request.resource.data.banAppealNote.size() <= 1000))
          // The reviewer is always the caller; an admin cannot attribute an
          // appeal decision to a colleague.
          && request.resource.data.get('banAppealReviewedBy', request.auth.uid) == request.auth.uid
          // Nobody may moderate themselves. Without this an admin could lock
          // out or un-restrict their own account with no other admin involved,
          // which is exactly the kind of action the audit trail exists to
          // attribute to someone else.
          && uid != request.auth.uid
        );

      // Deleting an account has to fan out to Firebase Auth, the user's
      // messages and their storage objects. That needs a trusted environment,
      // so it is deliberately impossible from the browser.
      allow delete: if false;

      match /blockedUsers/{blockedUid} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.blockedUserId == blockedUid
          && request.resource.data.keys().hasOnly(['blockedUserId', 'createdAt']);
      }

      match /conversationRefs/{conversationId} {
        allow read: if isSelf(uid);

        allow create, update: if signedIn()
          && request.resource.data.conversationId == conversationId
          && request.resource.data.memberIds is list
          && uid in request.resource.data.memberIds
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.keys().hasOnly([
            'conversationId', 'kind', 'title', 'memberIds', 'mutedUntil',
            'storefrontId', 'storefrontSlug', 'updatedAt', 'lastMessageAt',
            'lastMessageId', 'lastMessageSenderId', 'lastMessagePreview',
            'lastMessageStatus', 'inviteCode', 'unreadCount'
          ]);

        allow delete: if false;
      }

      match /memories/{memoryId} {
        allow read, delete: if isSelf(uid);

        allow create, update: if isSelf(uid)
          && request.resource.data.ownerUserId == uid
          && request.resource.data.sourceType in ['message', 'story']
          && request.resource.data.conversationId is string
          && request.resource.data.messageId is string
          && request.resource.data.keys().hasOnly([
            'ownerUserId', 'sourceType', 'conversationId', 'conversationTitle',
            'messageId', 'senderUserId', 'storyId', 'storyAuthorUserId',
            'storyAuthorName', 'storyHref', 'storefrontId', 'storefrontSlug',
            'storefrontName', 'communityId', 'communityName', 'productName',
            'productDescription', 'productPriceMinor', 'productCurrencyCode',
            'snippet', 'tags', 'followUpAt',
            'followUpLabel', 'followUpAction', 'followUpCompletedAt',
            'embedding', 'embeddingModel', 'embeddingProvider',
            'embeddingDimensions', 'embeddingUpdatedAt', 'semanticSummary',
            'languageCode',
            'sourceCreatedAt', 'createdAt', 'updatedAt'
          ]);
      }

      match /following/{followingUid} {
        allow read, delete: if isSelf(uid);

        allow create, update: if isSelf(uid)
          && followingUid != uid
          && request.resource.data.followerUserId == uid
          && request.resource.data.followingUserId == followingUid
          && request.resource.data.keys().hasOnly([
            'followerUserId', 'followingUserId', 'createdAt'
          ]);
      }
    }

    match /publicProfiles/{uid} {
      allow read: if resource.data.profileVisibility == 'public' || signedIn();

      allow create, update: if isSelf(uid)
        && request.resource.data.userId == uid
        && request.resource.data.keys().hasOnly([
          'userId', 'name', 'username', 'usernameLower', 'photoURL', 'bio',
          'city', 'countryCode', 'profileVisibility', 'handleDiscoverability',
          'updatedAt'
        ])
        && validUsername(request.resource.data.get('usernameLower', null));

      allow delete: if false;
    }

    match /usernames/{usernameLower} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.usernameLower == usernameLower
        && validUsername(request.resource.data.usernameLower)
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'usernameLower', 'updatedAt'
        ]);

      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.usernameLower == usernameLower
        && validUsername(request.resource.data.usernameLower)
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'usernameLower', 'updatedAt'
        ]);

      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /follows/{followId} {
      allow get: if signedIn();
      allow list: if false;

      allow create, update: if signedIn()
        && request.resource.data.followerUserId == request.auth.uid
        && request.resource.data.followingUserId is string
        && request.resource.data.followingUserId != request.auth.uid
        && request.resource.data.keys().hasOnly([
          'followerUserId', 'followingUserId', 'createdAt'
        ]);

      allow delete: if signedIn()
        && resource.data.followerUserId == request.auth.uid;
    }

    // --- Conversations -----------------------------------------------------

    match /conversations/{conversationId} {
      allow read: if isMember(resource);

      // You may create a conversation only if you put yourself in it —
      // otherwise a user could add two other people to a chat and read the
      // transcript they generate.
      allow create: if signedIn() && validConversationCreate();

      allow update: if isMember(resource)
        || (
          signedIn()
          && resource.data.kind == 'group'
          && resource.data.inviteCode is string
          && !(request.auth.uid in resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['memberIds', 'updatedAt'])
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && get(/databases/$(database)/documents/conversationInvites/$(resource.data.inviteCode)).data.active == true
          && get(/databases/$(database)/documents/conversationInvites/$(resource.data.inviteCode)).data.conversationId == conversationId
        );

      allow delete: if false;

      match /messages/{messageId} {
        // DO NOT add a `resource.data.memberIds is list` guard back here.
        //
        // Security rules are not filters: for a `list` query Firestore checks
        // the rule against the query's constraints, not against the documents.
        // It can prove `uid in memberIds` from
        // `where("memberIds", "array-contains", uid)`, but it cannot prove the
        // standalone type test from that same constraint — so the extra clause
        // evaluates to false and denies the thread to its own members. That is
        // exactly the bug this rule used to ship: chat sent fine (writes are
        // single-document, so they were unaffected) but no message ever loaded.
        //
        // Dropping the guard opens nothing: `in` against a non-list field is a
        // type error, which denies just as the guard would have.
        // Covered by scripts/firestore-rules-smoke.mjs.
        allow read: if signedIn()
          && request.auth.uid in resource.data.memberIds;

        // `senderId == request.auth.uid` is what stops a member of the
        // conversation posting as somebody else in it.
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.memberIds is list
          && request.auth.uid in request.resource.data.memberIds
          && isMember(conversationRef(conversationId))
          && request.resource.data.memberIds == conversationRef(conversationId).data.memberIds
          && request.resource.data.keys().hasOnly(
               [
                 'senderId', 'memberIds', 'body', 'createdAt', 'status', 'attachmentPath',
                 'attachmentUrl', 'attachmentName', 'attachmentMimeType',
                 'attachmentSize', 'storyId', 'deliveredTo', 'readBy',
                 'receiptUpdatedAt', 'replyToMessageId', 'replyToSenderId',
                 'replyToSnippet', 'reactions', 'reactionUpdatedAt', 'savedBy',
                 'pinnedBy', 'pinnedAt', 'memoryPrompt', 'memoryUpdatedAt'
               ]);

        // Allowed so a recipient can mark a message delivered/read. Tighten
        // this to only the `status` field once the chat UI settles.
        allow update: if isMember(conversationRef(conversationId));

        // No delete: "unsend" is a product decision, and implementing it as a
        // real delete would silently rewrite shared history.
        allow delete: if false;

        match /receipts/{uid} {
          allow read: if isMember(conversationRef(conversationId));

          allow create, update: if isSelf(uid)
            && isMember(conversationRef(conversationId))
            && request.resource.data.userId == uid
            && request.resource.data.status in ['delivered', 'read']
            && request.resource.data.keys().hasOnly([
              'userId', 'status', 'deliveredAt', 'readAt', 'updatedAt'
            ]);

          allow delete: if false;
        }
      }
    }

    match /conversationInvites/{inviteCode} {
      allow read: if signedIn()
        && resource.data.active == true;

      allow create: if signedIn()
        && request.resource.data.inviteCode == inviteCode
        && request.resource.data.kind == 'group'
        && request.resource.data.conversationId is string
        && request.resource.data.createdByUserId == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.keys().hasOnly([
          'conversationId', 'kind', 'title', 'inviteCode', 'createdByUserId',
          'active', 'createdAt', 'updatedAt'
        ])
        && getAfter(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.inviteCode == inviteCode
        && request.auth.uid in getAfter(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.memberIds;

      allow update: if signedIn()
        && resource.data.createdByUserId == request.auth.uid
        && request.resource.data.createdByUserId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'conversationId', 'kind', 'title', 'inviteCode', 'createdByUserId',
          'active', 'createdAt', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // --- Presence ----------------------------------------------------------

    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['uid', 'state', 'lastChanged']);
    }

    // --- Communities ------------------------------------------------------

    match /communities/{communityId} {
      allow read: if resource.data.visibility == 'public'
        || isCommunityMember(communityId)
        || isAdmin();

      allow create: if signedIn()
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.visibility in ['public', 'private']
        && request.resource.data.memberCount == 1
        && request.resource.data.keys().hasOnly([
          'ownerUserId', 'name', 'slug', 'description', 'city', 'countryCode',
          'visibility', 'memberCount', 'linkedStorefrontIds', 'createdAt',
          'updatedAt', 'inviteCode'
        ]);

      allow update: if signedIn()
        && (
          (
            resource.data.ownerUserId == request.auth.uid
            && request.resource.data.ownerUserId == request.auth.uid
            && request.resource.data.keys().hasOnly([
              'ownerUserId', 'name', 'slug', 'description', 'city',
              'countryCode', 'visibility', 'memberCount', 'linkedStorefrontIds',
              'createdAt', 'updatedAt', 'inviteCode'
            ])
          )
          || (
            canWriteAdmin()
            && canPerform('community.review')
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['reviewStatus', 'reviewedBy', 'reviewedAt', 'visibility', 'updatedAt'])
            && request.resource.data.reviewStatus in ['pending', 'approved', 'paused', 'rejected']
            && request.resource.data.visibility in ['public', 'private', 'unlisted']
            && request.resource.data.reviewedBy == request.auth.uid
          )
          || (
            !exists(communityMemberPath(communityId, request.auth.uid))
            && existsAfter(communityMemberPath(communityId, request.auth.uid))
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['memberCount', 'updatedAt'])
            && request.resource.data.memberCount == resource.data.memberCount + 1
            && (
              resource.data.visibility == 'public'
              || (
                resource.data.inviteCode is string
                && getAfter(communityMemberPath(communityId, request.auth.uid)).data.joinedByInviteCode == resource.data.inviteCode
                && get(/databases/$(database)/documents/communityInvites/$(resource.data.inviteCode)).data.active == true
                && get(/databases/$(database)/documents/communityInvites/$(resource.data.inviteCode)).data.communityId == communityId
              )
            )
          )
          || (
            isCommunityMember(communityId)
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['updatedAt'])
          )
        );

      allow delete: if false;

      match /members/{uid} {
        allow read: if get(communityPath(communityId)).data.visibility == 'public'
          || isCommunityMember(communityId);

        allow create: if isSelf(uid)
          && request.resource.data.userId == uid
          && request.resource.data.role in ['owner', 'moderator', 'member']
          && request.resource.data.keys().hasOnly([
            'userId', 'role', 'displayName', 'photoURL', 'joinedAt',
            'joinedByInviteCode'
          ])
          && (
            (
              getAfter(communityPath(communityId)).data.ownerUserId == uid
              && request.resource.data.role == 'owner'
            )
            || (
              get(communityPath(communityId)).data.visibility == 'public'
              && request.resource.data.role == 'member'
            )
            || (
              get(communityPath(communityId)).data.inviteCode is string
              && request.resource.data.role == 'member'
              && request.resource.data.joinedByInviteCode == get(communityPath(communityId)).data.inviteCode
              && get(/databases/$(database)/documents/communityInvites/$(request.resource.data.joinedByInviteCode)).data.active == true
              && get(/databases/$(database)/documents/communityInvites/$(request.resource.data.joinedByInviteCode)).data.communityId == communityId
            )
          );

        allow update, delete: if false;
      }

      match /chatMessages/{messageId} {
        allow read: if isCommunityMember(communityId);

        allow create: if isCommunityMember(communityId)
          && request.resource.data.authorUserId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.keys().hasOnly([
            'authorUserId', 'authorName', 'authorPhotoURL', 'body',
            'createdAt'
          ]);

        allow update, delete: if false;
      }

      match /posts/{postId} {
        allow read: if get(communityPath(communityId)).data.visibility == 'public'
          || isCommunityMember(communityId)
          || isAdmin();

        allow create: if isCommunityMember(communityId)
          && request.resource.data.authorUserId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.kind in ['post', 'question', 'listing', 'announcement']
          && validCommunityPostCommerce()
          && request.resource.data.keys().hasOnly([
            'authorUserId', 'authorName', 'authorPhotoURL', 'title', 'body',
            'kind', 'storefrontId', 'storefrontSlug', 'storefrontName',
            'productId', 'productName', 'productDescription',
            'productPriceMinor', 'productCurrencyCode', 'productPrimaryImageUrl',
            'createdAt', 'updatedAt'
          ]);

        allow update: if (isCommunityMember(communityId)
          && resource.data.authorUserId == request.auth.uid
          && request.resource.data.authorUserId == request.auth.uid
          && validCommunityPostCommerce()
          && request.resource.data.keys().hasOnly([
            'authorUserId', 'authorName', 'authorPhotoURL', 'title', 'body',
            'kind', 'storefrontId', 'storefrontSlug', 'storefrontName',
            'productId', 'productName', 'productDescription',
            'productPriceMinor', 'productCurrencyCode', 'productPrimaryImageUrl',
            'createdAt', 'updatedAt'
          ]))
          // Admin takedown. Same shape as the stories branch above, and for
          // the same reason: flag, never delete.
          || (canWriteAdmin()
            && canPerform('content.remove')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'moderationState', 'removedAt', 'removedBy', 'removedReason', 'updatedAt'
            ])
            && request.resource.data.moderationState in ['visible', 'removed']
            && request.resource.data.removedBy == request.auth.uid);

        allow delete: if isCommunityMember(communityId)
          && resource.data.authorUserId == request.auth.uid;

        match /reactions/{reactionId} {
          allow read: if get(communityPath(communityId)).data.visibility == 'public'
            || isCommunityMember(communityId);

          allow create, update: if signedIn()
            && (get(communityPath(communityId)).data.visibility == 'public'
              || isCommunityMember(communityId))
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.emoji is string
            && request.resource.data.keys().hasOnly([
              'userId', 'emoji', 'createdAt', 'updatedAt'
            ]);

          allow delete: if false;
        }
      }
    }

    match /communityInvites/{inviteCode} {
      allow read: if signedIn()
        && resource.data.active == true;

      allow create: if signedIn()
        && request.resource.data.inviteCode == inviteCode
        && request.resource.data.communityId is string
        && request.resource.data.createdByUserId == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.keys().hasOnly([
          'communityId', 'name', 'inviteCode', 'createdByUserId', 'active',
          'createdAt', 'updatedAt'
        ])
        && getAfter(communityPath(request.resource.data.communityId)).data.inviteCode == inviteCode
        && getAfter(communityPath(request.resource.data.communityId)).data.ownerUserId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.createdByUserId == request.auth.uid
        && request.resource.data.createdByUserId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'communityId', 'name', 'inviteCode', 'createdByUserId', 'active',
          'createdAt', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // --- Stories and Memories --------------------------------------------

    match /stories/{storyId} {
      allow read: if resource.data.audience == 'public'
        || (signedIn() && resource.data.authorUserId == request.auth.uid)
        || (signedIn()
          && resource.data.audience == 'custom'
          && request.auth.uid in resource.data.customAudienceUserIds)
        // Moderation cannot be done blind: an admin has to see the story a
        // report points at, and private/custom audiences are exactly the ones
        // a report is most likely to be about. The read is audited by the
        // takedown it enables, not by itself — Firebase does not log reads to
        // rules, so treat this as "may view", not "viewing is recorded".
        || isAdmin();

      allow create: if signedIn()
        && request.resource.data.authorUserId == request.auth.uid
        && validStoryStorefrontTarget()
        && validStoryCommunityTarget()
        && request.resource.data.keys().hasOnly([
          'authorUserId', 'authorName', 'authorCity', 'authorCountryCode',
          'textBody', 'audience', 'customAudienceUserIds', 'media',
          'primaryMediaUrl', 'primaryMediaType', 'isMemory', 'storefrontId',
          'storefrontSlug', 'storefrontName', 'communityId', 'communityName',
          'productName',
          'productDescription', 'productPriceMinor', 'productCurrencyCode',
          'createdAt', 'publishedAt', 'expiresAt', 'deletedAt'
        ]);

      allow update: if (signedIn()
        && resource.data.authorUserId == request.auth.uid
        && request.resource.data.authorUserId == request.auth.uid)
        /**
         * Takedown, not deletion.
         *
         * `allow delete: if false` stays in force, so a removed story is never
         * destroyed — it is flagged `removed` and stops being served by the
         * client. That matters for two reasons: an appeal needs the content to
         * still exist to be reviewed against, and a hard delete would quietly
         * erase the evidence a report was filed about.
         */
        || (canWriteAdmin()
          && canPerform('content.remove')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'moderationState', 'removedAt', 'removedBy', 'removedReason', 'updatedAt'
          ])
          && request.resource.data.moderationState in ['visible', 'removed']
          && request.resource.data.removedBy == request.auth.uid);

      allow delete: if false;

      match /views/{uid} {
        allow create, update: if isSelf(uid);
        allow read: if signedIn()
          && get(/databases/$(database)/documents/stories/$(storyId)).data.authorUserId == request.auth.uid;
      }

      match /reactions/{reactionId} {
        allow create, update: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.emoji is string
          && request.resource.data.keys().hasOnly([
            'userId', 'emoji', 'createdAt', 'updatedAt'
          ]);
        allow read: if signedIn();
        allow delete: if signedIn()
          && resource.data.userId == request.auth.uid;
      }

      match /comments/{commentId} {
        allow read: if get(/databases/$(database)/documents/stories/$(storyId)).data.audience == 'public'
          || signedIn();
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 280
          && request.resource.data.keys().hasOnly([
            'userId', 'userName', 'userPhotoURL', 'body', 'createdAt'
          ]);
        allow update: if false;
        allow delete: if signedIn()
          && (
            resource.data.userId == request.auth.uid
            || get(/databases/$(database)/documents/stories/$(storyId)).data.authorUserId == request.auth.uid
          );
      }

      match /replies/{uid} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/stories/$(storyId)).data.authorUserId == request.auth.uid;

        allow create, update: if isSelf(uid)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'userId', 'userName', 'userPhotoURL', 'count', 'updatedAt'
          ]);

        allow delete: if false;
      }
    }

    match /storyPlacementEvents/{eventId} {
      allow create: if signedIn()
        && request.resource.data.viewerUserId == request.auth.uid
        && request.resource.data.surface == 'stories'
        && request.resource.data.action in [
          'impression', 'like', 'comment', 'reply', 'share', 'save',
          'ad_impression', 'ad_click'
        ]
        && request.resource.data.sourceKind in ['story', 'community-post', 'ad-slot']
        && request.resource.data.tab is string
        && request.resource.data.placementId is string
        && request.resource.data.keys().hasOnly([
          'viewerUserId', 'placementId', 'action', 'tab', 'surface',
          'sourceKind', 'storyId', 'communityId', 'storefrontId', 'productId',
          'broadCity', 'countryCode', 'createdAt'
        ]);

      allow read, update, delete: if false;
    }

    // --- Shops ------------------------------------------------------------

    match /storefronts/{storefrontId} {
      allow read: if resource.data.visibility == 'public'
        || (signedIn() && resource.data.ownerUserId == request.auth.uid)
        || isAdmin();

      allow create: if signedIn()
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerUserId', 'name', 'slug', 'bio', 'category', 'contactPhone',
          'contactEmail', 'visibility', 'verificationState', 'coverUrl',
          'coverPath', 'ownerCity', 'ownerCountryCode', 'createdAt', 'updatedAt'
        ]);

      allow update: if (
          signedIn()
          && resource.data.ownerUserId == request.auth.uid
          && request.resource.data.ownerUserId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'slug', 'bio', 'category', 'contactPhone', 'contactEmail',
            'visibility', 'ownerCity', 'ownerCountryCode', 'coverUrl',
            'coverPath', 'verificationState', 'updatedAt'
          ])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationState'])
            || request.resource.data.verificationState in ['unverified', 'pending']
          )
        )
        || (
          canWriteAdmin()
          && canPerform('shop.review')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'reviewStatus', 'verificationState', 'reviewedBy', 'reviewedAt',
            'riskFlag', 'riskFlaggedBy', 'riskFlaggedAt', 'updatedAt'
          ])
          && request.resource.data.reviewStatus in ['pending', 'approved', 'paused', 'rejected']
          && request.resource.data.verificationState in ['unverified', 'pending', 'verified', 'rejected']
          && request.resource.data.reviewedBy == request.auth.uid
          // A risk flag is an internal suspicion marker, not a state the shop
          // is put into: it must never change what buyers see. It is separate
          // from reviewStatus because "approved" and "suspicious" are not
          // mutually exclusive — a shop can pass review and still warrant a
          // second look by another admin.
          && (request.resource.data.get('riskFlag', null) == null
              || request.resource.data.riskFlag == 'suspicious')
          && request.resource.data.riskFlaggedBy == request.auth.uid
        );

      allow delete: if false;

      match /private/{privateDoc} {
        allow read, write: if signedIn()
          && get(/databases/$(database)/documents/storefronts/$(storefrontId)).data.ownerUserId == request.auth.uid;
      }
    }

    match /products/{productId} {
      allow read: if resource.data.status == 'active'
        || (signedIn() && resource.data.storefrontOwnerUserId == request.auth.uid)
        || isAdmin();

      allow create: if signedIn()
        && request.resource.data.storefrontOwnerUserId == request.auth.uid
        && get(/databases/$(database)/documents/storefronts/$(request.resource.data.storefrontId)).data.ownerUserId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'storefrontId', 'storefrontSlug', 'storefrontName',
          'storefrontOwnerUserId', 'storefrontCategory', 'ownerCity',
          'ownerCountryCode', 'title', 'description', 'category',
          'priceMinor', 'currencyCode', 'inventoryQuantity', 'status',
          'primaryImageUrl', 'media', 'createdAt', 'updatedAt'
        ]);

      allow update: if (signedIn()
        && resource.data.storefrontOwnerUserId == request.auth.uid
        && request.resource.data.storefrontOwnerUserId == request.auth.uid)
        // Admin takedown of a listing. `status` is deliberately NOT writable
        // here: it is the seller's own stock/visibility control, and letting a
        // moderator flip it would let them re-publish or de-list stock on a
        // seller's behalf. Moderation is a separate axis (`moderationState`)
        // so the two never fight over one field.
        || (canWriteAdmin()
          && canPerform('content.remove')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'moderationState', 'removedAt', 'removedBy', 'removedReason', 'updatedAt'
          ])
          && request.resource.data.moderationState in ['visible', 'removed']
          && request.resource.data.removedBy == request.auth.uid);

      allow delete: if false;
    }

    match /orders/{orderId} {
      allow read: if signedIn()
        && (resource.data.buyerUserId == request.auth.uid
          || resource.data.storefrontOwnerUserId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.buyerUserId == request.auth.uid;

      // Two very different writers share this collection, so the update rule is
      // split deliberately rather than opened up:
      //   - the seller advances the order through its lifecycle;
      //   - the buyer only records HOW they intend to pay, and only while the
      //     order is still unpaid. The affectedKeys() guard means the buyer
      //     cannot touch status, totals or any other field, so this cannot be
      //     used to self-approve an order or rewrite what they owe.
      allow update: if signedIn()
        && (
          resource.data.storefrontOwnerUserId == request.auth.uid
          || (
            resource.data.buyerUserId == request.auth.uid
            && resource.data.status == 'awaiting_payment'
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['paymentCountryCode', 'paymentProviderCode', 'updatedAt'])
          )
        );

      allow delete: if false;
    }

    match /safetyReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUserId == request.auth.uid;
      allow read: if isAdmin();
      allow update: if canWriteAdmin()
        && canPerform('report.triage')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewedBy', 'reviewedAt', 'resolution', 'updatedAt'
        ])
        && request.resource.data.status in ['new', 'reviewing', 'resolved', 'dismissed']
        && request.resource.data.reviewedBy == request.auth.uid
        && (
          request.resource.data.get('resolution', null) == null
          || request.resource.data.resolution.size() < 500
        );
      allow delete: if false;
    }

    // Append-only admin action trail.
    //
    // Every admin mutation in the app writes its document change and this
    // audit entry inside one Firestore transaction, so a rejected audit write
    // rolls the change back with it. That is what makes "admins leave a trail"
    // a property of the database rather than a promise from the client — and
    // it means the field list below is load-bearing. If runAdminMutation()
    // starts writing a field that is not listed here, every admin action in
    // the product starts failing with permission-denied until the two agree.
    //
    // update/delete are denied outright: an editable audit log records nothing.
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if canWriteAdmin()
        && request.resource.data.adminUserId == request.auth.uid
        && request.resource.data.adminRole == adminClaimRole()
        && request.resource.data.adminRole is string
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.targetType is string
        && request.resource.data.targetId is string
        // The reason is the whole point of the trail. Mirrors REASON_MIN_LENGTH
        // in firebaseAdmin.ts — change one, change the other.
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 8
        && request.resource.data.reason.size() <= 500
        && request.resource.data.before is map
        && request.resource.data.after is map
        && request.resource.data.keys().hasOnly([
          'adminUserId', 'adminName', 'adminRole', 'action', 'targetType',
          'targetId', 'reason', 'before', 'after', 'detail',
          'actorUserAgent', 'actorPlatform', 'actorLanguage', 'actorTimezone',
          'actorScreen', 'ipAddress', 'createdAt'
        ]);
      allow update, delete: if false;
    }

    /**
     * Client-reported failures. Written by `lib/observability.ts`.
     *
     * Unlike the audit log, any signed-in user may write here — an error that
     * only admins could report is an error we never hear about, since almost
     * every failure a user hits happens on a normal account. That openness is
     * the risk, so the constraints below are what make it acceptable:
     *
     *  - `userId` must be null or the caller's own uid, so nobody can file an
     *    error under someone else's name.
     *  - Every string is length-capped, and the document as a whole is capped
     *    at 10 KB via `data.size()`. That last one is the real guard: the
     *    `context` map is free-form, and Rules cannot walk its values, so
     *    bounding the entire document is the only way to stop someone
     *    submitting a multi-megabyte blob.
     *  - The field set is closed, so this cannot be used as a general-purpose
     *    key/value store.
     *
     * Update is limited to acknowledging: an admin marking an entry as seen.
     * Editing the message, scope or stack would make the log untrustworthy in
     * exactly the way that matters — an admin could rewrite what failed.
     */
    match /errorLogs/{logId} {
      allow read: if isAdmin();

      allow create: if signedIn()
        && request.resource.data.scope is string
        && request.resource.data.scope.size() > 0
        && request.resource.data.scope.size() <= 64
        && request.resource.data.severity in ['error', 'warning', 'info']
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && (request.resource.data.stack == null
            || (request.resource.data.stack is string && request.resource.data.stack.size() <= 2000))
        && request.resource.data.context is map
        && request.resource.data.context.size() <= 20
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() <= 64
        && (request.resource.data.route == null
            || (request.resource.data.route is string && request.resource.data.route.size() <= 200))
        && (request.resource.data.userId == null
            || request.resource.data.userId == request.auth.uid)
        && (request.resource.data.userAgent == null
            || (request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 300))
        && (request.resource.data.appVersion == null
            || (request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 40))
        // Acknowledgement is admin-owned state; a client cannot pre-set it.
        && request.resource.data.acknowledgedBy == null
        && request.resource.data.acknowledgedAt == null
        && request.resource.data.keys().hasOnly([
          'scope', 'severity', 'message', 'stack', 'context', 'route',
          'sessionId', 'userId', 'userAgent', 'appVersion',
          'acknowledgedBy', 'acknowledgedAt', 'createdAt'
        ])
        // Whole-document size cap. See the note above on why this, rather than
        // per-field limits, is what actually bounds a free-form map.
        && request.resource.data.size() <= 10000;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['acknowledgedBy', 'acknowledgedAt'])
        && request.resource.data.acknowledgedBy == request.auth.uid;

      allow delete: if false;
    }

    // --- Collection-group rules -------------------------------------------
    //
    // These two exist because the admin console needs to query *across*
    // parents: every community's posts at once for the moderation queue, and
    // every conversation's messages at once to count platform volume. A
    // collection-group query only matches a rule declared with `{path=**}`,
    // so the nested rules above — which are scoped to one parent — cannot
    // serve them no matter how they are worded.
    //
    // A collection-group rule matches EVERY collection with that name, present
    // and future. That is the risk being taken here, and it is the reason both
    // are gated on a claim rather than on `isAdmin()`'s document fallback.
    match /{path=**}/posts/{postId} {
      allow read: if isAdmin();
      allow update: if canWriteAdmin()
        && canPerform('content.remove')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'moderationState', 'removedAt', 'removedBy', 'removedReason', 'updatedAt'
        ])
        && request.resource.data.moderationState in ['visible', 'removed']
        && request.resource.data.removedBy == request.auth.uid;
    }

    /**
     * Direct messages, visible to the two roles that handle user disputes.
     *
     * This is the highest-power read in the file and is deliberately narrower
     * than the others: `canPerform('user.moderate')` admits super_admin and
     * support_admin only. A `moderator` — who can remove content and lock
     * communities — cannot read private conversations, because nothing in
     * content moderation requires it.
     *
     * Only the count path uses it today (see loadAnalytics in
     * firebaseAdmin.ts). It grants more than a count needs, because Firestore
     * cannot express "count but not read"; the mitigation is the role gate and
     * the fact that every admin action is audited, not the query shape.
     */
    match /{path=**}/messages/{messageId} {
      allow read: if adminClaimRole() != null && canPerform('user.moderate');
    }

    // Everything not matched above is denied by default. Do not add a
    // catch-all allow here — that is how direct-access projects get breached.
  }
}
