rules_version = '2';

// ---------------------------------------------------------------------------
// Savanna — Firestore security rules
//
// These rules ARE the authorisation layer. The browser talks to Firestore
// directly and the project's web config ships inside the bundle, so there is no
// server of ours in front of this data to catch a mistake. Anything not
// explicitly allowed below is denied.
//
// Pair this with App Check (see client/src/lib/firebase.ts). Rules decide what a
// signed-in user may read; App Check decides whether the caller is your app at
// all. Rules alone still hold, but without App Check anyone can lift the public
// config from the browser and script against your project on your bill.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validUsername(value) {
      return value == null || (value is string && value.matches('^[a-z0-9_]{3,24}$'));
    }

    // `resource` is null on create, so this helper is only valid for
    // read/update/delete. Create rules check `request.resource` instead.
    function isMember(conversation) {
      return signedIn()
        && conversation != null
        && conversation.data.memberIds is list
        && request.auth.uid in conversation.data.memberIds;
    }

    function conversationRef(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId));
    }

    function communityPath(communityId) {
      return /databases/$(database)/documents/communities/$(communityId);
    }

    function communityMemberPath(communityId, uid) {
      return /databases/$(database)/documents/communities/$(communityId)/members/$(uid);
    }

    function isCommunityMember(communityId) {
      return signedIn()
        && exists(communityMemberPath(communityId, request.auth.uid));
    }

    function validConversationCreate() {
      return request.resource.data.keys().hasOnly([
          'kind', 'title', 'memberIds', 'directKey', 'storefrontId',
          'storefrontSlug', 'createdAt', 'updatedAt', 'lastMessageAt',
          'lastMessageId', 'lastMessageSenderId', 'lastMessagePreview',
          'lastMessageStatus', 'mutedUntil'
        ])
        && request.resource.data.kind in ['direct', 'group', 'merchant_support']
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() >= 2
        && request.auth.uid in request.resource.data.memberIds
        && (
          request.resource.data.kind != 'direct'
          || (
            request.resource.data.memberIds.size() == 2
            && request.resource.data.directKey is string
          )
        );
    }

    // --- Profiles ----------------------------------------------------------

    match /users/{uid} {
      // Private account profile. This may contain auth-derived contact details,
      // so only the owner can read it. Public lookup lives in publicProfiles.
      allow read: if isSelf(uid);

      // The field whitelist matters. Without it a user could write any
      // attribute onto their own profile — including anything the app later
      // learns to trust, such as a role or a verification flag. Adding a field
      // to the app means adding it here.
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(
               [
               'name', 'username', 'usernameLower', 'email', 'phoneNumber',
               'photoURL', 'bio', 'city', 'countryCode', 'profileVisibility',
               'phoneVisibility',
               'handleDiscoverability', 'storyAudienceDefault',
               'readReceiptsEnabled', 'lastSeenVisibility',
               'courseProgressOptIn', 'createdAt', 'updatedAt'
             ])
        && validUsername(request.resource.data.get('usernameLower', null));

      allow update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(
             [
               'name', 'username', 'usernameLower', 'email', 'phoneNumber',
               'photoURL', 'bio', 'city', 'countryCode', 'profileVisibility',
               'phoneVisibility',
               'handleDiscoverability', 'storyAudienceDefault',
               'readReceiptsEnabled', 'lastSeenVisibility',
               'courseProgressOptIn', 'createdAt', 'updatedAt'
             ])
        && validUsername(request.resource.data.get('usernameLower', null));

      // Deleting an account has to fan out to Firebase Auth, the user's
      // messages and their storage objects. That needs a trusted environment,
      // so it is deliberately impossible from the browser.
      allow delete: if false;

      match /blockedUsers/{blockedUid} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.blockedUserId == blockedUid
          && request.resource.data.keys().hasOnly(['blockedUserId', 'createdAt']);
      }

      match /conversationRefs/{conversationId} {
        allow read: if isSelf(uid);

        allow create, update: if signedIn()
          && request.resource.data.conversationId == conversationId
          && request.resource.data.memberIds is list
          && uid in request.resource.data.memberIds
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.keys().hasOnly([
            'conversationId', 'kind', 'title', 'memberIds', 'mutedUntil',
            'storefrontId', 'storefrontSlug', 'updatedAt', 'lastMessageAt',
            'lastMessageId', 'lastMessageSenderId', 'lastMessagePreview',
            'lastMessageStatus'
          ]);

        allow delete: if false;
      }

      match /following/{followingUid} {
        allow read, delete: if isSelf(uid);

        allow create, update: if isSelf(uid)
          && followingUid != uid
          && request.resource.data.followerUserId == uid
          && request.resource.data.followingUserId == followingUid
          && request.resource.data.keys().hasOnly([
            'followerUserId', 'followingUserId', 'createdAt'
          ]);
      }
    }

    match /publicProfiles/{uid} {
      allow read: if resource.data.profileVisibility == 'public' || signedIn();

      allow create, update: if isSelf(uid)
        && request.resource.data.userId == uid
        && request.resource.data.keys().hasOnly([
          'userId', 'name', 'username', 'usernameLower', 'photoURL', 'bio',
          'city', 'countryCode', 'profileVisibility', 'handleDiscoverability',
          'updatedAt'
        ])
        && validUsername(request.resource.data.get('usernameLower', null));

      allow delete: if false;
    }

    match /usernames/{usernameLower} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.usernameLower == usernameLower
        && validUsername(request.resource.data.usernameLower)
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'usernameLower', 'updatedAt'
        ]);

      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.usernameLower == usernameLower
        && validUsername(request.resource.data.usernameLower)
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'usernameLower', 'updatedAt'
        ]);

      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /follows/{followId} {
      allow get: if signedIn();
      allow list: if false;

      allow create, update: if signedIn()
        && request.resource.data.followerUserId == request.auth.uid
        && request.resource.data.followingUserId is string
        && request.resource.data.followingUserId != request.auth.uid
        && request.resource.data.keys().hasOnly([
          'followerUserId', 'followingUserId', 'createdAt'
        ]);

      allow delete: if signedIn()
        && resource.data.followerUserId == request.auth.uid;
    }

    // --- Conversations -----------------------------------------------------

    match /conversations/{conversationId} {
      allow read: if isMember(resource);

      // You may create a conversation only if you put yourself in it —
      // otherwise a user could add two other people to a chat and read the
      // transcript they generate.
      allow create: if signedIn() && validConversationCreate();

      allow update: if isMember(resource);

      allow delete: if false;

      match /messages/{messageId} {
        // DO NOT add a `resource.data.memberIds is list` guard back here.
        //
        // Security rules are not filters: for a `list` query Firestore checks
        // the rule against the query's constraints, not against the documents.
        // It can prove `uid in memberIds` from
        // `where("memberIds", "array-contains", uid)`, but it cannot prove the
        // standalone type test from that same constraint — so the extra clause
        // evaluates to false and denies the thread to its own members. That is
        // exactly the bug this rule used to ship: chat sent fine (writes are
        // single-document, so they were unaffected) but no message ever loaded.
        //
        // Dropping the guard opens nothing: `in` against a non-list field is a
        // type error, which denies just as the guard would have.
        // Covered by scripts/firestore-rules-smoke.mjs.
        allow read: if signedIn()
          && request.auth.uid in resource.data.memberIds;

        // `senderId == request.auth.uid` is what stops a member of the
        // conversation posting as somebody else in it.
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.memberIds is list
          && request.auth.uid in request.resource.data.memberIds
          && isMember(conversationRef(conversationId))
          && request.resource.data.memberIds == conversationRef(conversationId).data.memberIds
          && request.resource.data.keys().hasOnly(
               [
                 'senderId', 'memberIds', 'body', 'createdAt', 'status', 'attachmentPath',
                 'attachmentUrl', 'attachmentName', 'attachmentMimeType',
                 'attachmentSize', 'storyId', 'deliveredTo', 'readBy', 'receiptUpdatedAt'
               ]);

        // Allowed so a recipient can mark a message delivered/read. Tighten
        // this to only the `status` field once the chat UI settles.
        allow update: if isMember(conversationRef(conversationId));

        // No delete: "unsend" is a product decision, and implementing it as a
        // real delete would silently rewrite shared history.
        allow delete: if false;

        match /receipts/{uid} {
          allow read: if isMember(conversationRef(conversationId));

          allow create, update: if isSelf(uid)
            && isMember(conversationRef(conversationId))
            && request.resource.data.userId == uid
            && request.resource.data.status in ['delivered', 'read']
            && request.resource.data.keys().hasOnly([
              'userId', 'status', 'deliveredAt', 'readAt', 'updatedAt'
            ]);

          allow delete: if false;
        }
      }
    }

    // --- Presence ----------------------------------------------------------

    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['uid', 'state', 'lastChanged']);
    }

    // --- Communities ------------------------------------------------------

    match /communities/{communityId} {
      allow read: if resource.data.visibility == 'public'
        || isCommunityMember(communityId);

      allow create: if signedIn()
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.visibility in ['public', 'private']
        && request.resource.data.memberCount == 1
        && request.resource.data.keys().hasOnly([
          'ownerUserId', 'name', 'slug', 'description', 'city', 'countryCode',
          'visibility', 'memberCount', 'linkedStorefrontIds', 'createdAt',
          'updatedAt'
        ]);

      allow update: if signedIn()
        && (
          (
            resource.data.ownerUserId == request.auth.uid
            && request.resource.data.ownerUserId == request.auth.uid
            && request.resource.data.keys().hasOnly([
              'ownerUserId', 'name', 'slug', 'description', 'city',
              'countryCode', 'visibility', 'memberCount', 'linkedStorefrontIds',
              'createdAt', 'updatedAt'
            ])
          )
          || (
            resource.data.visibility == 'public'
            && !exists(communityMemberPath(communityId, request.auth.uid))
            && existsAfter(communityMemberPath(communityId, request.auth.uid))
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['memberCount', 'updatedAt'])
            && request.resource.data.memberCount == resource.data.memberCount + 1
          )
        );

      allow delete: if false;

      match /members/{uid} {
        allow read: if get(communityPath(communityId)).data.visibility == 'public'
          || isCommunityMember(communityId);

        allow create: if isSelf(uid)
          && request.resource.data.userId == uid
          && request.resource.data.role in ['owner', 'moderator', 'member']
          && request.resource.data.keys().hasOnly([
            'userId', 'role', 'displayName', 'photoURL', 'joinedAt'
          ])
          && (
            (
              getAfter(communityPath(communityId)).data.ownerUserId == uid
              && request.resource.data.role == 'owner'
            )
            || (
              get(communityPath(communityId)).data.visibility == 'public'
              && request.resource.data.role == 'member'
            )
          );

        allow update, delete: if false;
      }
    }

    // --- Stories and Memories --------------------------------------------

    match /stories/{storyId} {
      allow read: if resource.data.audience == 'public'
        || (signedIn() && resource.data.authorUserId == request.auth.uid)
        || (signedIn()
          && resource.data.audience == 'custom'
          && request.auth.uid in resource.data.customAudienceUserIds);

      allow create: if signedIn()
        && request.resource.data.authorUserId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'authorUserId', 'authorName', 'authorCity', 'authorCountryCode',
          'textBody', 'audience', 'customAudienceUserIds', 'media',
          'primaryMediaUrl', 'primaryMediaType', 'isMemory', 'storefrontId',
          'storefrontSlug', 'storefrontName', 'productName',
          'productDescription', 'productPriceMinor', 'productCurrencyCode',
          'createdAt', 'publishedAt', 'expiresAt', 'deletedAt'
        ]);

      allow update: if signedIn()
        && resource.data.authorUserId == request.auth.uid
        && request.resource.data.authorUserId == request.auth.uid;

      allow delete: if false;

      match /views/{uid} {
        allow create, update: if isSelf(uid);
        allow read: if signedIn()
          && get(/databases/$(database)/documents/stories/$(storyId)).data.authorUserId == request.auth.uid;
      }

      match /reactions/{reactionId} {
        allow create, update: if signedIn()
          && request.resource.data.userId == request.auth.uid;
        allow read: if signedIn();
      }

      match /comments/{commentId} {
        allow read: if get(/databases/$(database)/documents/stories/$(storyId)).data.audience == 'public'
          || signedIn();
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 280
          && request.resource.data.keys().hasOnly([
            'userId', 'userName', 'userPhotoURL', 'body', 'createdAt'
          ]);
        allow update, delete: if false;
      }
    }

    // --- Shops ------------------------------------------------------------

    match /storefronts/{storefrontId} {
      allow read: if resource.data.visibility == 'public'
        || (signedIn() && resource.data.ownerUserId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerUserId', 'name', 'slug', 'bio', 'category', 'contactPhone',
          'contactEmail', 'visibility', 'verificationState', 'coverUrl',
          'coverPath', 'ownerCity', 'ownerCountryCode', 'createdAt', 'updatedAt'
        ]);

      allow update: if signedIn()
        && resource.data.ownerUserId == request.auth.uid
        && request.resource.data.ownerUserId == request.auth.uid;

      allow delete: if false;

      match /private/{privateDoc} {
        allow read, write: if signedIn()
          && get(/databases/$(database)/documents/storefronts/$(storefrontId)).data.ownerUserId == request.auth.uid;
      }
    }

    match /products/{productId} {
      allow read: if resource.data.status == 'active'
        || (signedIn() && resource.data.storefrontOwnerUserId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.storefrontOwnerUserId == request.auth.uid
        && get(/databases/$(database)/documents/storefronts/$(request.resource.data.storefrontId)).data.ownerUserId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'storefrontId', 'storefrontSlug', 'storefrontName',
          'storefrontOwnerUserId', 'storefrontCategory', 'ownerCity',
          'ownerCountryCode', 'title', 'description', 'category',
          'priceMinor', 'currencyCode', 'inventoryQuantity', 'status',
          'primaryImageUrl', 'media', 'createdAt', 'updatedAt'
        ]);

      allow update: if signedIn()
        && resource.data.storefrontOwnerUserId == request.auth.uid
        && request.resource.data.storefrontOwnerUserId == request.auth.uid;

      allow delete: if false;
    }

    match /orders/{orderId} {
      allow read: if signedIn()
        && (resource.data.buyerUserId == request.auth.uid
          || resource.data.storefrontOwnerUserId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.buyerUserId == request.auth.uid;

      // Two very different writers share this collection, so the update rule is
      // split deliberately rather than opened up:
      //   - the seller advances the order through its lifecycle;
      //   - the buyer only records HOW they intend to pay, and only while the
      //     order is still unpaid. The affectedKeys() guard means the buyer
      //     cannot touch status, totals or any other field, so this cannot be
      //     used to self-approve an order or rewrite what they owe.
      allow update: if signedIn()
        && (
          resource.data.storefrontOwnerUserId == request.auth.uid
          || (
            resource.data.buyerUserId == request.auth.uid
            && resource.data.status == 'awaiting_payment'
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['paymentCountryCode', 'paymentProviderCode', 'updatedAt'])
          )
        );

      allow delete: if false;
    }

    match /safetyReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUserId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Everything not matched above is denied by default. Do not add a
    // catch-all allow here — that is how direct-access projects get breached.
  }
}
