# ---------------------------------------------------------------------------
# Savanna — environment configuration template
#
# Copy to `.env` and fill in. `.env` is gitignored; NEVER commit real values.
#
#   cp .env.example .env
#
# Precedence: real environment variables on the host always win over `.env`.
# Anything prefixed VITE_ is inlined into the client bundle at build time and is
# therefore PUBLIC — never put a secret behind a VITE_ name.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------

# "development" | "production". In production the server serves the built
# client from dist/public instead of starting Vite.
NODE_ENV=development

# Port the Express server binds to. If busy, the next free port is probed.
PORT=3000

# Number of reverse-proxy hops to trust for req.ip / req.protocol / req.secure.
# Set to the real hop count behind your load balancer, or "false" to disable.
# Getting this wrong makes rate limiting key on the proxy IP for every client.
TRUST_PROXY=1

# --- Database (required) ---------------------------------------------------

# MySQL / TiDB connection string used by Drizzle ORM.
# mysql://user:password@host:3306/savanna
DATABASE_URL=

# --- Session signing (required) --------------------------------------------

# HS256 key for session JWTs. Must be >= 32 bytes of high-entropy random data.
# Generate with: openssl rand -base64 48
# ROTATING THIS INVALIDATES EVERY ACTIVE SESSION.
JWT_SECRET=

# --- Auth: Supabase (the only identity provider) ---------------------------
#
# The Manus OAuth integration has been removed. OAUTH_SERVER_URL, VITE_APP_ID,
# VITE_OAUTH_PORTAL_URL and OWNER_OPEN_ID are no longer read by anything.

# Project URL.
SUPABASE_URL=https://your-project.supabase.co

# `sb_publishable_...` key. Safe to ship to the browser — enforcement comes
# from Row Level Security, not from hiding this value.
SUPABASE_PUBLISHABLE_KEY=

# Legacy JWT secret: Supabase → Project Settings → API → JWT Settings.
# Lets the server verify access tokens locally, with no network round trip.
# SERVER ONLY — never put this behind a VITE_ name.
# Keep the quotes: the value contains "/" and "+" characters.
SUPABASE_JWT_SECRET=""

# Optional. Overrides the JWKS endpoint used to verify asymmetrically signed
# (ES256) access tokens. Leave unset to derive it from SUPABASE_URL. Only useful
# for tests or a proxy in front of Supabase.
# SUPABASE_JWKS_URL=

# Supabase user id (a UUID) auto-promoted to `admin` on first sign-in.
# Leave empty once you have promoted at least one admin account.
OWNER_SUPABASE_USER_ID=

# --- Object storage ("Forge" presign API) ----------------------------------

# Base URL + key used to mint presigned upload/download URLs.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Client-side mirror of the above for direct browser uploads (PUBLIC).
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# --- Payments: Flutterwave -------------------------------------------------

# Secret key used for server-side transaction re-verification.
FLUTTERWAVE_SECRET_KEY=

# SHA-256 hash of the webhook secret, used to verify the `verif-hash` header.
# Compute with: printf '%s' "$FLUTTERWAVE_SECRET_HASH" | sha256sum
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# --- Security headers ------------------------------------------------------

# Set to "true" to upgrade the Content-Security-Policy from Report-Only to
# enforcing. Only safe once the inline Manus runtime script is removed from
# index.html (plan item P2-1) or moved behind a nonce/hash.
CSP_ENFORCE=false

# --- Analytics (optional) --------------------------------------------------

# Both must be set, otherwise the analytics <script> tag is stripped from the
# built HTML at build time. Setting only one silently disables analytics.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
