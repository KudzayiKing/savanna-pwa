# ---------------------------------------------------------------------------
# Savanna — environment configuration template
#
# Copy to `.env` and fill in. `.env` is gitignored; NEVER commit real values.
#
#   cp .env.example .env
#
# Precedence: real environment variables on the host always win over `.env`.
# Anything prefixed VITE_ is inlined into the client bundle at build time and is
# therefore PUBLIC — never put a secret behind a VITE_ name.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------

# "development" | "production". In production the server serves the built
# client from dist/public instead of starting Vite.
NODE_ENV=development

# Port the Express server binds to. If busy, the next free port is probed.
PORT=3000

# Number of reverse-proxy hops to trust for req.ip / req.protocol / req.secure.
# Set to the real hop count behind your load balancer, or "false" to disable.
# Getting this wrong makes rate limiting key on the proxy IP for every client.
TRUST_PROXY=1

# --- Firebase (identity, data, storage) ------------------------------------
#
# Firebase is the primary backend for the MVP: Phone Auth for identity,
# Firestore for application data, Firebase Storage for media.
#
# The six values below are the *web app config* printed under
# Project settings → General → Your apps → SDK setup and configuration.
#
# THEY ARE PUBLIC BY DESIGN. They ship inside the browser bundle and are not
# secrets. Enforcement comes from Firestore/Storage security rules and App
# Check — never from hiding these values.
#
# Even so, restrict the key: Google Cloud Console → APIs & Services →
# Credentials → API keys → add an HTTP referrer restriction listing your
# domains. Without that, anyone who copies your config can bill API calls to
# your project's quota.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Prepended when a user types a local number (0772… → +263772…).
# Zimbabwe by default; change it if your users are elsewhere.
VITE_DEFAULT_COUNTRY_CODE=+263

# App Check. This is what stops someone who copies the public web config from
# driving your Firestore and racking up the bill. LEAVE THIS EMPTY AND NOTHING
# GUARDS THE BACKEND BUT SECURITY RULES — acceptable for local work only, not
# once the site is public.
#
# Create a reCAPTCHA v3 site key, register it under Build → App Check →
# Apps → your web app, then paste the site key here.
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Set to 1 locally so App Check accepts the debug token printed in the browser
# console on first load. Register that token in the Firebase console to keep
# working. NEVER set this in production: a debug token lets any machine
# impersonate your app and bypass App Check entirely.
VITE_FIREBASE_APP_CHECK_DEBUG=

# --- Database (dormant during the Firebase MVP) ----------------------------
#
# The MySQL/Drizzle layer below is retained but not on the MVP request path.
# It comes back with payments and the Learn rollout. Leave DATABASE_URL unset
# unless you are actively running the Express API.

# MySQL / TiDB connection string used by Drizzle ORM.
# mysql://user:password@host:3306/savanna
DATABASE_URL=

# --- Session signing (required) --------------------------------------------

# HS256 key for session JWTs. Must be >= 32 bytes of high-entropy random data.
# Generate with: openssl rand -base64 48
# ROTATING THIS INVALIDATES EVERY ACTIVE SESSION.
JWT_SECRET=

# --- Auth: Supabase (the only identity provider) ---------------------------
#
# The Manus OAuth integration has been removed. OAUTH_SERVER_URL, VITE_APP_ID,
# VITE_OAUTH_PORTAL_URL and OWNER_OPEN_ID are no longer read by anything.

# Project URL.
SUPABASE_URL=https://your-project.supabase.co

# `sb_publishable_...` key. Safe to ship to the browser — enforcement comes
# from Row Level Security, not from hiding this value.
SUPABASE_PUBLISHABLE_KEY=

# Legacy JWT secret: Supabase → Project Settings → API → JWT Settings.
# Lets the server verify access tokens locally, with no network round trip.
# SERVER ONLY — never put this behind a VITE_ name.
# Keep the quotes: the value contains "/" and "+" characters.
SUPABASE_JWT_SECRET=""

# Optional. Overrides the JWKS endpoint used to verify asymmetrically signed
# (ES256) access tokens. Leave unset to derive it from SUPABASE_URL. Only useful
# for tests or a proxy in front of Supabase.
# SUPABASE_JWKS_URL=

# Supabase user id (a UUID) auto-promoted to `admin` on first sign-in.
# Leave empty once you have promoted at least one admin account.
OWNER_SUPABASE_USER_ID=

# --- Object storage ("Forge" presign API) ----------------------------------

# Base URL + key used to mint presigned upload/download URLs.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Client-side mirror of the above for direct browser uploads (PUBLIC).
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# --- Savanna AI: local-first Gemma ----------------------------------------
#
# Public mode selector used by the client orchestrator:
# - auto: local memory retrieval first, then browser Gemma when available, then
#   optional cloud fallback.
# - local: use only the browser/on-device provider when the runtime is present.
# - cloud: use only the server fallback gateway.
# - mock: test provider for UI and fallback behavior.
VITE_SAVANNA_INFERENCE=auto

# Public browser runtime/model artifact configuration. No secrets belong here.
# This is the LiteRT-LM web artifact, not the raw safetensors checkpoint.
VITE_SAVANNA_LOCAL_GEMMA_MODEL_URL=https://huggingface.co/litert-community/gemma-4-E2B-it-litert-lm/resolve/main/gemma-4-E2B-it-web.litertlm
VITE_SAVANNA_LITERT_LM_RUNTIME_URL=https://cdn.jsdelivr.net/npm/@litert-lm/core/+esm
VITE_SAVANNA_EMBEDDING_GEMMA_MODEL_ID=onnx-community/embeddinggemma-300m-ONNX

# Local TranslateGemma uses the browser-ready MediaPipe task artifact when
# translation is requested. If the browser cannot load the licensed web model,
# Savanna falls back to the optional server gateway below, then passthrough.
VITE_SAVANNA_TRANSLATE_GEMMA_MODEL_ID=google/translategemma-4b-it
VITE_SAVANNA_TRANSLATE_GEMMA_MODEL_URL=https://huggingface.co/litert-community/TranslateGemma-4B-IT/resolve/main/translategemma-4b-it-int8-web.task
VITE_SAVANNA_MEDIAPIPE_GENAI_RUNTIME_URL=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-genai/+esm
VITE_SAVANNA_MEDIAPIPE_GENAI_WASM_URL=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-genai/wasm

# Optional server-only cloud fallback. Do not prefix secrets with VITE_.
# The PWA never needs GEMMA_API_KEY or GEMMA_*_ENDPOINT for local inference.
GEMMA_API_BASE_URL=
GEMMA_API_KEY=
GEMMA_CHAT_ENDPOINT=
GEMMA_EMBEDDING_ENDPOINT=
GEMMA_TRANSLATE_ENDPOINT=
GEMMA_CHAT_MODEL=google/gemma-4-E2B-it-qat-mobile-transformers
GEMMA_EMBEDDING_MODEL=google/embeddinggemma-300m
GEMMA_TRANSLATE_MODEL=google/translategemma-4b-it

# --- Payments: Flutterwave -------------------------------------------------

# Secret key used for server-side transaction re-verification.
FLUTTERWAVE_SECRET_KEY=

# SHA-256 hash of the webhook secret, used to verify the `verif-hash` header.
# Compute with: printf '%s' "$FLUTTERWAVE_SECRET_HASH" | sha256sum
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# --- Encryption at rest ----------------------------------------------------

# AES-256-GCM key for merchant settlement/payout references.
# Generate with: openssl rand -base64 48
# REQUIRED IN PRODUCTION. Deliberately NOT the JWT_SECRET: rotating the session
# secret is a routine operation that invalidates every live session, and tying
# this to the same value means that operation also destroys stored payout data.
# In development it falls back to JWT_SECRET with a warning.
SETTLEMENT_ENCRYPTION_KEY=

# --- Security headers ------------------------------------------------------

# Set to "true" to upgrade the Content-Security-Policy from Report-Only to
# enforcing. Only safe once the inline Manus runtime script is removed from
# index.html (plan item P2-1) or moved behind a nonce/hash.
CSP_ENFORCE=false

# Comma-separated list of extra origins allowed to make state-changing API
# calls. Only needed when the browser client is served from a different host
# than this API (e.g. a preview deployment). Leave empty for same-origin
# deployments — every entry here is a host the CSRF guard will trust.
# Example: ALLOWED_ORIGINS=https://preview.example,https://staging.example
ALLOWED_ORIGINS=

# Re-enables the `Authorization: Bearer <session>` fallback for authenticating
# requests instead of the session cookie. Off by default and NOT recommended:
# the header is readable by page script, so a leaked token bypasses HttpOnly,
# SameSite and Secure. Only enable for a client you control that genuinely
# cannot send cookies.
ALLOW_BEARER_AUTH=false

# --- Dev server ------------------------------------------------------------

# Extra hosts the Vite dev server will answer on, comma-separated. localhost and
# 127.0.0.1 are always allowed, so leave this empty for local development.
# Add an entry only when you deliberately serve dev through a tunnel or a
# preview domain — every host listed here is one your dev server will accept
# traffic for. Dev-only; the production build never reads it.
# Example: VITE_ALLOWED_HOSTS=my-preview.example,my-tunnel.example
VITE_ALLOWED_HOSTS=

# --- Analytics (optional) --------------------------------------------------

# Both must be set, otherwise the analytics <script> tag is stripped from the
# built HTML at build time. Setting only one silently disables analytics.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
